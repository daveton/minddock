{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MindDock",
  "version": "0.1.0",
  "identifier": "top.daveton.minddock",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev -- --host 127.0.0.1 --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm --prefix ../web run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MindDock",
        "width": 1280,
        "height": 860,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "macOSPrivateApi": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Local-first knowledge workspace",
    "longDescription": "MindDock is a local-first Hybrid Markdown knowledge workspace."
  }
}
